{
  "expo": {
    "name": "MarketLingo",
    "slug": "marketlingo",
    "version": "1.2.3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d71827be-8e4e-4959-baa8-94a363c4ff4f",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "marketlingo",
    "splash": {
      "image": "./assets/splash-wordmark.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B5CF6"
    },
    "ios": {
      "splash": {
        "image": "./assets/splash-purple.png",
        "resizeMode": "cover",
        "backgroundColor": "#8B5CF6"
      },
      "supportsTablet": false,
      "appleTeamId": "PM32G4952G",
      "bundleIdentifier": "app.marketlingo.aerospace",
      "buildNumber": "163",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "MarketLingo needs microphone access to record your interview responses in the Mock Lab for AI feedback.",
        "NSSpeechRecognitionUsageDescription": "MarketLingo uses speech recognition to transcribe your interview practice responses."
      },
      "associatedDomains": [
        "applinks:market-verse.com",
        "applinks:www.market-verse.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3A1729"
      },
      "package": "app.marketlingo.aerospace"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "d71827be-8e4e-4959-baa8-94a363c4ff4f"
      },
      "router": {
        "origin": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "buildReactNativeFromSource": true
          },
          "android": {}
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MarketLingo uses your camera to scan a friend's code so you can add them.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      "expo-font",
      "./plugins/withIosReleaseVersion",
      "./plugins/withFmtXcodeFix"
    ],
    "owner": "maxime020707"
  }
}
