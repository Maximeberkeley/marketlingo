{
  "expo": {
    "name": "MarketLingo",
    "slug": "marketlingo",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "marketlingo",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1020"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.marketlingo.aerospace",
      "buildNumber": "100",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.marketlingo.aerospace.shared"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "MarketLingo needs microphone access to record your interview responses in the Mock Lab for AI feedback.",
        "NSSpeechRecognitionUsageDescription": "MarketLingo uses speech recognition to transcribe your interview practice responses."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1020"
      },
      "package": "app.marketlingo.aerospace"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "d71827be-8e4e-4959-baa8-94a363c4ff4f"
      },
      "router": {
        "origin": false
      }
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
          }
        }
      ],
      "expo-web-browser"
    ],
    "owner": "maxime020707"
  }
}
